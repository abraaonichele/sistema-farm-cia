{
  "name": "atendimento-inj-farmacia",
  "version": "1.0.63",
  "description": "Aplicativo desktop para atendimento de injetaveis com Firebase.",
  "main": "electron-main.js",
  "author": "Mega",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/abraaonichele/sistema-farm-cia.git"
  },
  "scripts": {
    "start": "electron .",
    "test:trier": "node --test tests/trier-products.test.cjs tests/trier-sales.test.cjs",
    "supabase:password-reset": "node scripts/serve-supabase-password-reset.mjs",
    "data:compact": "node gerar-dados-medicamentos-compactos.mjs",
    "build:win": "node scripts/build-installers.cjs windows",
    "build:win7": "node scripts/build-installers.cjs windows",
    "build:win:ia32": "node scripts/build-installers.cjs windows-ia32",
    "build:win7:ia32": "node scripts/build-installers.cjs windows-ia32",
    "build:win:portable": "node scripts/build-installers.cjs windows-portable",
    "build:mac": "node scripts/build-installers.cjs macos",
    "build:installers": "node scripts/build-installers.cjs all",
    "build:dir": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "compression": "maximum",
    "appId": "com.megafarmacia.atendimentoinj",
    "productName": "Atendimento Inj Farmacia",
    "artifactName": "Atendimento-Inj-Farmacia-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "abraaonichele",
      "repo": "sistema-farm-cia",
      "releaseType": "release"
    },
    "icon": "build/icon.ico",
    "directories": {
      "output": "instaladores/.build-output"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "index.html",
      "main.js",
      "styles.css",
      "offer-template.css",
      "trier-products.cjs",
      "trier-sales.cjs",
      "public-offers/supabase-config.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon-1024.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atendimento Inj Farmacia"
    }
  }
}
